{
  "name": "nowen-interview-ai",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --watch server/index.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node server/index.mjs",
    "test": "node --test server/*.test.mjs scripts/*.test.mjs",
    "test:e2e": "node --test tests/*.browser.test.mjs",
    "import:legacy": "node scripts/import-legacy.mjs",
    "bank:seed": "node scripts/seed-advanced.mjs",
    "account": "node scripts/accounts.mjs",
    "backup": "node scripts/database-maintenance.mjs backup",
    "restore": "node scripts/database-maintenance.mjs restore"
  },
  "dependencies": { "acorn": "^8.15.0", "react": "^19.1.0", "react-dom": "^19.1.0" },
  "devDependencies": { "playwright": "^1.55.0", "vite": "^7.1.0" }
}
